	(text "ERC power declarations: verified sources via passive paths.\nBAT_AUX: BT1 -> F4 -> F1; VSYS_5V: U11 -> U12 -> D3.\nGND: common battery return. Flags are not extra supplies."
		(at 731.52 495.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "73c5c315-9ed0-4980-86c4-0c1a00112d47")
	)
	(text "C07 MATLAB schematic transfer\nLayout and connectivity extracted independently.\nNearby connections use wires; distant connections use global labels.\nFootprints and 3D models are not fabrication-qualified.\nOriginal MATLAB identifiers are stored in component properties."
		(at 889 40.64 0)
		(effects
			(font
				(size 2 2)
			)
