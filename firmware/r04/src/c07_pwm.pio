; One atomic word: [11:0]=HS-1, [12]=LS enable, [24:13]=second phase-1.
; ISR retains the complete previous command. Empty FIFO repeats it at the
; cycle boundary; normal command updates never stop or restart this SM.
; GP6 drives Q1, GP7 drives Q2. Both are active HIGH at the MCU.
.program c07_pwm
.side_set 2
.wrap_target
cycle:
    mov x, isr       side 0
    pull noblock     side 0
    mov isr, osr     side 0
    out x, 12        side 0
hs:
    jmp x-- hs       side 1
    set y, 30        side 0
dt_hl:
    jmp y-- dt_hl    side 0 [3]
    out y, 1         side 0
    out x, 12        side 0
    jmp !y diode     side 0
ls:
    jmp x-- ls       side 2
    set y, 30        side 0
dt_lh:
    jmp y-- dt_lh    side 0 [3]
    jmp cycle        side 0 [1]
diode:
    jmp x-- diode    side 0
    jmp cycle        side 0
.wrap

; SM1 independently monitors PG9=0, BAT_FLT13=1, PV_FLT14=1, STOPPED15=0.
; Hard faults go directly to IRQ0. PV_STOPPED first records IRQ1.
; Its sticky SET0 has priority over SM0 until an explicit stopped SM restart.
.program c07_interlock
; Y=3 is loaded once while stopped. Normal PWM updates never reset this SM.
poll:
    mov osr, pins
    out null, 9
    out x, 1
    jmp x-- fault
    out null, 3
    out x, 2
    jmp x!=y fault
    out x, 1
    jmp !x poll
    irq 1
fault:
    irq 0
.wrap_target
    set pins, 0
.wrap

; SM2 hardware lease also has priority over SM0. It cannot renew itself.
; CPU refreshes X using nonblocking forced PULL/OUT without stopping the SM.
; Refresh never changes PC or clears IRQs: once the countdown falls through,
; even a concurrent refresh cannot return to the countdown or release SET0.
; OUT_STICKY keeps SET0 asserted during forced PULL/OUT X after expiry.
; IRQ2 records expiry before the common IRQ0.
.program c07_lease
lease:
    jmp x-- lease [31]
    irq 2
    irq 0
.wrap_target
    set pins, 0
.wrap
