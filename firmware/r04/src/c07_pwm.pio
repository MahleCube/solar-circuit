; Two words per cycle, fetched with both gates OFF. DMA never repeats.
; word1=HS ticks-1; word2=(tail ticks-1)<<12 | (LS ticks-1); LS=0 skips.
; GP6 drives Q1, GP7 drives Q2. Both are active HIGH at the MCU.
.program c07_pwm
.side_set 2
.wrap_target
    pull block       side 0
    mov x, osr       side 0
    pull block       side 0
    wait 0 irq 0     side 0
hs:
    jmp x-- hs       side 1
    set y, 30        side 0
dt_hl:
    jmp y-- dt_hl    side 0 [3]
    out x, 12        side 0
    jmp !x tail      side 0
    wait 0 irq 0     side 0
ls:
    jmp x-- ls       side 2
    set y, 30        side 0
dt_lh:
    jmp y-- dt_lh    side 0 [3]
tail:
    out x, 20        side 0
tail_loop:
    jmp x-- tail_loop side 0
.wrap

; SM1 independently monitors PG9=0, BAT_FLT13=1, PV_FLT14=1, STOPPED15=0.
; Its writes have priority over SM0. SET0 must wrap in ONE instruction.
.program c07_interlock
    set y, 3
poll:
    mov osr, pins
    out null, 9
    out x, 1
    jmp x-- fault
    out null, 3
    out x, 2
    jmp x!=y fault
    out x, 1
    jmp !x poll
fault:
    irq 0
.wrap_target
    set pins, 0
.wrap

; SM2 hardware lease also has priority over SM0. It cannot renew itself.
; A stalled CPU or DMA cannot issue pulses beyond this time limit.
.program c07_lease
    pull block
    out x, 32
lease:
    jmp x-- lease [31]
    irq 0
.wrap_target
    set pins, 0
.wrap
